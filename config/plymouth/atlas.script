# Atlas Plymouth theme

Window.SetBackgroundTopColor(0.031, 0.043, 0.063);
Window.SetBackgroundBottomColor(0.031, 0.043, 0.063);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

progress_track_image = Image("progress-track.png");
progress_fill_image = Image("progress-fill.png");
progress_track = Sprite(progress_track_image);
progress_fill = Sprite(progress_fill_image.Scale(1, progress_fill_image.GetHeight()));
progress_target = 0;
progress_displayed = 0;
progress_width = 0;

prompt_sprite = Sprite();
entry_sprite = Sprite();
message_sprite = Sprite();
status = "normal";

fun place_main_elements() {
  center_x = Window.GetWidth() / 2;
  center_y = Window.GetHeight() / 2;

  logo_sprite.SetX(center_x - logo_image.GetWidth() / 2);
  logo_sprite.SetY(center_y - logo_image.GetHeight() / 2 - 36);
  logo_sprite.SetZ(10);

  progress_x = center_x - progress_track_image.GetWidth() / 2;
  progress_y = center_y + logo_image.GetHeight() / 2 + 42;
  progress_track.SetX(progress_x);
  progress_track.SetY(progress_y);
  progress_track.SetZ(10);
  progress_fill.SetX(progress_x);
  progress_fill.SetY(progress_y);
  progress_fill.SetZ(11);
  progress_fill.SetOpacity(0);
}

place_main_elements();

fun boot_progress_callback(duration, progress) {
  # Keep progress within the track and avoid moving backwards when estimates change.
  if (progress < 0)
    progress = 0;
  if (progress > 1)
    progress = 1;
  if (progress > progress_target)
    global.progress_target = progress;
}

fun refresh_callback() {
  if (status == "normal") {
    # Ease toward Plymouth's reported boot progress rather than jumping between stages.
    global.progress_displayed += (progress_target - progress_displayed) * 0.12;
    if (progress_target - progress_displayed < 0.001)
      global.progress_displayed = progress_target;
    width = Math.Int(progress_fill_image.GetWidth() * progress_displayed);
    if (width < 1)
      width = 1;
    if (width != progress_width) {
      progress_fill.SetImage(progress_fill_image.Scale(width, progress_fill_image.GetHeight()));
      global.progress_width = width;
    }
    if (progress_target > 0)
      progress_fill.SetOpacity(1);
  }
}

fun hide_prompt() {
  global.status = "normal";
  prompt_sprite.SetOpacity(0);
  entry_sprite.SetOpacity(0);
  logo_sprite.SetOpacity(1);
  progress_track.SetOpacity(1);
  if (progress_target > 0)
    progress_fill.SetOpacity(1);
  else
    progress_fill.SetOpacity(0);
}

fun display_normal_callback() {
  hide_prompt();
}

fun display_password_callback(prompt, bullets) {
  global.status = "password";
  progress_track.SetOpacity(0);
  progress_fill.SetOpacity(0);
  logo_sprite.SetOpacity(0.38);

  if (!prompt)
    prompt = "Enter password";

  prompt_image = Image.Text(prompt, 0.72, 0.79, 0.88);
  prompt_sprite.SetImage(prompt_image);
  prompt_sprite.SetX(Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
  prompt_sprite.SetY(Window.GetHeight() / 2 + logo_image.GetHeight() / 2 + 28);
  prompt_sprite.SetZ(20);
  prompt_sprite.SetOpacity(1);

  bullet_text = "";
  for (i = 0; i < bullets; i++)
    bullet_text += "*";

  entry_image = Image.Text(bullet_text, 0.40, 0.82, 1.0);
  entry_sprite.SetImage(entry_image);
  entry_sprite.SetX(Window.GetWidth() / 2 - entry_image.GetWidth() / 2);
  entry_sprite.SetY(Window.GetHeight() / 2 + logo_image.GetHeight() / 2 + 58);
  entry_sprite.SetZ(20);
  entry_sprite.SetOpacity(1);
}

fun message_callback(text) {
  message_image = Image.Text(text, 0.58, 0.64, 0.72);
  message_sprite.SetImage(message_image);
  message_sprite.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
  message_sprite.SetY(Window.GetHeight() - 72);
  message_sprite.SetZ(20);
  message_sprite.SetOpacity(1);
}

fun hide_message_callback(text) {
  message_sprite.SetOpacity(0);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetMessageFunction(message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
