#!/usr/bin/env bash

set -euo pipefail

# Quickshell's Process keeps an empty stdin pipe open. Selection tools interpret
# a pipe as a list of predefined regions and wait forever instead of opening
# their overlay, so commands which do not explicitly pipe regions need EOF.
exec </dev/null

# Quickshell may have started before a package was added to the active profile.
export PATH="${HOME}/.nix-profile/bin:/etc/profiles/per-user/${USER}/bin:/run/current-system/sw/bin:${PATH}"

mode="${1:-region}"
shift || true
capture_delay=0
audio_source="system"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --delay)
      [[ $# -ge 2 && "$2" =~ ^(0|3|5|10)$ ]] || exit 2
      capture_delay="$2"
      shift 2
      ;;
    --audio)
      [[ $# -ge 2 && "$2" =~ ^(system|microphone|none)$ ]] || exit 2
      audio_source="$2"
      shift 2
      ;;
    *) exit 2 ;;
  esac
done
screenshots_dir="${HOME}/Pictures/Screenshots"
timestamp="$(date +'%Y-%m-%d_%H-%M-%S')"
filename="Screenshot_${timestamp}.png"
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="${runtime_dir}/atlas-wf-recorder.pid"
pause_file="${runtime_dir}/atlas-wf-recorder.paused"
started_file="${runtime_dir}/atlas-wf-recorder.started"
paused_total_file="${runtime_dir}/atlas-wf-recorder.paused-total"

cleanup_recording_state() {
  rm -f "${pid_file}" "${pause_file}" "${started_file}" "${paused_total_file}"
}

numeric_file_value() {
  local file="${1}"
  local fallback="${2:-0}"
  local value
  [[ -f "${file}" ]] || {
    printf '%s\n' "${fallback}"
    return
  }
  value="$(<"${file}")"
  if [[ "${value}" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "${value}"
  else
    printf '%s\n' "${fallback}"
  fi
}

recording_elapsed() {
  local now started paused_total paused_since
  now="$(date +%s)"
  started="$(numeric_file_value "${started_file}" "${now}")"
  paused_total="$(numeric_file_value "${paused_total_file}" 0)"
  paused_since=0
  if [[ -f "${pause_file}" ]]; then
    paused_since="$(numeric_file_value "${pause_file}" "${now}")"
    paused_total=$((paused_total + now - paused_since))
  fi
  printf '%s\n' "$((now - started - paused_total))"
}

recording_pid() {
  [[ -f "${pid_file}" ]] || return 1
  local recorder_pid
  recorder_pid="$(<"${pid_file}")"
  [[ "${recorder_pid}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "${recorder_pid}" 2>/dev/null || return 1
  [[ "$(ps -p "${recorder_pid}" -o comm=)" == "wf-recorder" ]] || return 1
  printf '%s\n' "${recorder_pid}"
}

case "${mode}" in
  status)
    if recording_pid >/dev/null; then
      if [[ -f "${pause_file}" ]]; then
        printf 'paused %s\n' "$(recording_elapsed)"
      else
        printf 'recording %s\n' "$(recording_elapsed)"
      fi
    else
      cleanup_recording_state
      printf 'stopped\n'
    fi
    exit 0
    ;;
  record-pause)
    recorder_pid="$(recording_pid)" || exit 0
    if [[ -f "${pause_file}" ]]; then
      kill -CONT "${recorder_pid}"
      paused_since="$(numeric_file_value "${pause_file}" "$(date +%s)")"
      paused_total="$(numeric_file_value "${paused_total_file}" 0)"
      printf '%s\n' "$((paused_total + $(date +%s) - paused_since))" \
        >"${paused_total_file}"
      rm -f "${pause_file}"
    else
      kill -STOP "${recorder_pid}"
      date +%s >"${pause_file}"
    fi
    exit 0
    ;;
  record-stop)
    recorder_pid="$(recording_pid)" || exit 0
    kill -CONT "${recorder_pid}" 2>/dev/null || true
    kill -INT "${recorder_pid}"
    cleanup_recording_state
    notify-send "Screen recording saved" "${HOME}/Videos/Recordings"
    exit 0
    ;;
  record|record-region|record-window|record-display)
    recordings_dir="${HOME}/Videos/Recordings"
    recorder_target=()
    recorder_audio=(-a)

    recording_pid >/dev/null && exit 0
    cleanup_recording_state

    case "${mode}" in
      record|record-region)
        geometry="$(slurp)" || exit 1
        recorder_target=(-g "${geometry}")
        ;;
      record-window)
        geometry="$(hyprctl clients -j | jq -r '.[] | select(.mapped) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' | slurp)" || exit 1
        recorder_target=(-g "${geometry}")
        ;;
      record-display)
        geometry="$(slurp -o)" || exit 1
        recorder_target=(-g "${geometry}")
        ;;
    esac

    recorder_audio=()
    if [[ "${audio_source}" != "none" ]]; then
      audio_device='@DEFAULT_AUDIO_SINK@'
      [[ "${audio_source}" == "microphone" ]] && audio_device='@DEFAULT_AUDIO_SOURCE@'
      audio_node="$(wpctl inspect "${audio_device}" 2>/dev/null | awk -F'"' '/node.name =/ { print $2; exit }')" || true
      if [[ -z "${audio_node}" ]]; then
        notify-send "Screen recording failed" "Selected audio device is unavailable. Choose another source or No audio."
        exit 3
      fi
      [[ "${audio_source}" == "system" ]] && audio_node="${audio_node}.monitor"
      recorder_audio=("--audio=${audio_node}")
    fi

    mkdir -p "${recordings_dir}"
    recording_file="${recordings_dir}/Recording_${timestamp}.mp4"
    recorder_log="${runtime_dir}/atlas-wf-recorder.log"
    wf-recorder "${recorder_target[@]}" "${recorder_audio[@]}" \
      -f "${recording_file}" \
      >"${recorder_log}" 2>&1 &
    recorder_pid=$!
    printf '%s\n' "${recorder_pid}" >"${pid_file}"
    date +%s >"${started_file}"
    printf '0\n' >"${paused_total_file}"
    sleep 0.15
    if ! kill -0 "${recorder_pid}" 2>/dev/null; then
      cleanup_recording_state
      notify-send "Screen recording failed" \
        "wf-recorder could not start; see ${recorder_log}"
      exit 3
    fi
    notify-send "Screen recording started" "Press Print Screen and select Record again to stop"
    exit 0
    ;;
  color)
    exec hyprpicker -a -f hex
    ;;
  region)
    hyprshot_mode="region"
    ;;
  display)
    hyprshot_mode="output"
    ;;
  window)
    hyprshot_mode="window"
    ;;
  *)
    exit 2
    ;;
esac

sleep "${capture_delay}"
mkdir -p "${screenshots_dir}"
exec hyprshot -m "${hyprshot_mode}" -o "${screenshots_dir}" -f "${filename}"
