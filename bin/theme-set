#!/usr/bin/env bash

set -euo pipefail

ATLAS_PATH="${ATLAS_PATH:-$HOME/.local/share/atlas}"

STYLE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/atlas/style"
CURRENT_THEME_DIR="$STYLE_DIR/current"
NEXT_THEME_DIR="$STYLE_DIR/next-theme"

theme="${1:-}"

if [[ -z "$theme" ]]; then
  echo "Usage: theme-set <theme>"
  exit 1
fi

THEME_DIR="$(theme-dir "$theme")"
THEME_FILE="$THEME_DIR/colors.toml"
THEME_WALLPAPERS_DIR="$THEME_DIR/wallpapers"

# Validate theme
theme-colors "$theme" >/dev/null

mapfile -t wallpapers < <(
  [[ -d "$THEME_WALLPAPERS_DIR" ]] || exit 0
  find "$THEME_WALLPAPERS_DIR" \
    -maxdepth 1 \
    -type f \
    \( \
    -iname '*.jpg' -o \
    -iname '*.jpeg' -o \
    -iname '*.png' -o \
    -iname '*.webp' \
    \)
)

((${#wallpapers[@]} > 0)) || {
  echo "Theme has no wallpapers: $THEME_WALLPAPERS_DIR" >&2
  exit 1
}

#
# Prepare next theme
#

rm -rf "$NEXT_THEME_DIR"
mkdir -p "$NEXT_THEME_DIR"

cp "$THEME_FILE" "$NEXT_THEME_DIR/colors.toml"

#
# Generate application-specific styles
#

theme-set-templates

#
# Select wallpaper
#

wallpaper="${wallpapers[RANDOM % ${#wallpapers[@]}]}"
cp "$wallpaper" "$NEXT_THEME_DIR/background"

#
# Store active theme name
#

printf '%s\n' "$theme" >"$NEXT_THEME_DIR/theme"

#
# Promote next theme to current
#

rm -rf "$CURRENT_THEME_DIR"
mv "$NEXT_THEME_DIR" "$CURRENT_THEME_DIR"

QUICKSHELL_THEME_DIR="$ATLAS_PATH/config/quickshell"
mkdir -p "$QUICKSHELL_THEME_DIR"
cp "$CURRENT_THEME_DIR/ThemeColors.json" "$QUICKSHELL_THEME_DIR/"

theme-refresh

echo "Theme set to: $theme"
