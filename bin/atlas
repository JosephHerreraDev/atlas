#!/usr/bin/env bash

set -euo pipefail

ATLAS_PATH="${ATLAS_PATH:-$HOME/.local/share/atlas}"
ATLAS_CONFIG="${ATLAS_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/atlas/config.nix}"
ATLAS_REPOSITORY="https://github.com/JosephHerreraDev/atlas.git"

usage() {
  cat <<'EOF'
Usage:
  atlas config check
  atlas settings read
  atlas settings status
  atlas settings save <system|displays>
  atlas rebuild
  atlas rollback
  atlas doctor
  atlas update
EOF
}

die() { printf 'atlas: %s\n' "$*" >&2; exit 1; }

show_logo() {
  local logo="$ATLAS_PATH/logo.txt"
  if [[ -r "$logo" ]]; then
    cat "$logo" >&2
    printf '\n' >&2
  fi
}

ensure_config() {
  if [[ ! -f "$ATLAS_CONFIG" ]]; then
    mkdir -p "$(dirname "$ATLAS_CONFIG")"
    printf '{ atlasModules, ... }:\n{\n  imports = [ ];\n}\n' > "$ATLAS_CONFIG"
  fi
}

seed_hypr_config() {
  local source_dir="$ATLAS_PATH/config/hypr"
  local target_dir="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
  local symlink_target atlas_target

  [[ -d "$source_dir" ]] || die "Hyprland configuration source not found: $source_dir"

  if [[ -L "$target_dir" ]]; then
    symlink_target="$(readlink -f "$target_dir")"
    atlas_target="$(readlink -f "$source_dir")"
    if [[ "$symlink_target" == "$atlas_target" ]]; then
      printf 'Atlas: migrating the old Hyprland directory symlink.\n'
      rm "$target_dir"
    else
      printf 'Atlas: %s is a user-managed symlink; leaving it untouched.\n' "$target_dir" >&2
      return
    fi
  fi

  mkdir -p "$target_dir"
  rsync -a --ignore-existing "$source_dir/" "$target_dir/"
  printf 'Atlas: seeded missing Hyprland files into %s.\n' "$target_dir"
}

rebuild() {
  sudo env "ATLAS_USER=$(id -un)" "ATLAS_HOME=$HOME" "ATLAS_CONFIG=$ATLAS_CONFIG" \
    nixos-rebuild switch --impure --flake "path:$ATLAS_PATH#atlas"
  seed_hypr_config
  rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/atlas/rebuild-required"
}

check_config() {
  ensure_config
  ATLAS_USER="$(id -un)" ATLAS_HOME="$HOME" ATLAS_CONFIG="$ATLAS_CONFIG" \
    nix eval --impure --raw "path:$ATLAS_PATH#nixosConfigurations.atlas.config.system.build.toplevel.drvPath" >/dev/null
  echo "Atlas configuration is valid."
}

doctor() {
  local failures=0 command_name
  printf 'Atlas path: %s\nConfig: %s\n' "$ATLAS_PATH" "$ATLAS_CONFIG"
  for command_name in nix nixos-rebuild rsync hyprctl qs theme-dir theme-set wallpaper-set; do
    if ! command -v "$command_name" >/dev/null; then
      printf 'MISSING: %s\n' "$command_name"
      failures=$((failures + 1))
    fi
  done
  if ! check_config; then failures=$((failures + 1)); fi
  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    hyprctl monitors >/dev/null || { echo "FAIL: Hyprland is not responding."; failures=$((failures + 1)); }
  fi
  while IFS= read -r theme; do
    if ! theme-colors "$theme" >/dev/null || ! theme_has_wallpaper "$(theme-dir "$theme")"; then
      printf 'FAIL: invalid theme %s\n' "$theme"
      failures=$((failures + 1))
    fi
  done < <(theme-list)
  ((failures == 0)) || die "$failures check(s) failed"
  echo "Atlas doctor found no problems."
}

theme_has_wallpaper() {
  local directory="$1"
  [[ -d "$directory/wallpapers" ]] &&
    find "$directory/wallpapers" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
      -print -quit | grep -q .
}

show_logo

case "${1:-}" in
  config)
    case "${2:-}" in
      check) check_config ;;
      *) usage; exit 2 ;;
    esac
    ;;
  settings)
    shift
    exec "$ATLAS_PATH/bin/atlas-settings" "$@"
    ;;
  rebuild) rebuild ;;
  rollback) sudo nixos-rebuild switch --rollback ;;
  doctor) doctor ;;
  update)
    if git -C "$ATLAS_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      git -C "$ATLAS_PATH" pull --ff-only
    else
      for command_name in curl git tar rsync; do
        command -v "$command_name" >/dev/null || die "required command not found: $command_name"
      done
      update_dir="$(mktemp -d)"
      backup_dir="${XDG_STATE_HOME:-$HOME/.local/state}/atlas/backups/$(date +%Y%m%d-%H%M%S)"
      trap 'rm -rf -- "$update_dir"' EXIT
      curl -fsSL "https://github.com/JosephHerreraDev/atlas/archive/refs/heads/main.tar.gz" \
        | tar -xz --strip-components=1 -C "$update_dir"
      mkdir -p "$backup_dir"
      rsync -a --delete --exclude='/.git/' --backup \
        --backup-dir="$backup_dir" "$update_dir/" "$ATLAS_PATH/"
      git -C "$ATLAS_PATH" init --initial-branch=main
      git -C "$ATLAS_PATH" remote add origin "$ATLAS_REPOSITORY"
      git -C "$ATLAS_PATH" fetch origin main
      git -C "$ATLAS_PATH" reset --mixed origin/main
      git -C "$ATLAS_PATH" branch --set-upstream-to=origin/main main
      echo "Replaced files were backed up under $backup_dir."
    fi
    echo 'Update downloaded. Review the changes, then run `atlas rebuild`.'
    ;;
  *) usage; exit 2 ;;
esac
