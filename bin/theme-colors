#!/usr/bin/env bash

set -euo pipefail

theme_colors() {
  local theme_file="$1"

  awk '
    BEGIN {
      required = "background surface surface_hover foreground foreground_muted border accent selection_background selection_foreground cursor error warning success info ansi_black ansi_red ansi_green ansi_yellow ansi_blue ansi_magenta ansi_cyan ansi_white ansi_bright_black ansi_bright_red ansi_bright_green ansi_bright_yellow ansi_bright_blue ansi_bright_magenta ansi_bright_cyan ansi_bright_white"
      split(required, keys, " ")
    }
    match($0, /^[[:space:]]*([A-Za-z0-9_-]+)[[:space:]]*=[[:space:]]*"([^"]*)"/, fields) {
      colors[fields[1]] = fields[2]
    }
    END {
      invalid = 0
      for (i = 1; i <= length(keys); i++) {
        key = keys[i]
        if (!(key in colors)) {
          printf "Missing theme color: %s\n", key > "/dev/stderr"
          invalid = 1
        } else if (colors[key] !~ /^#[0-9A-Fa-f]{6}$/) {
          printf "Invalid theme color %s: %s\n", key, colors[key] > "/dev/stderr"
          invalid = 1
        }
      }
      if (invalid) exit 1

      printf "%s|%s|%s|%s|%s|%s|%s\n",
        colors["background"], colors["foreground"], colors["accent"],
        colors["error"], colors["warning"], colors["success"], colors["info"]
    }
  ' "$theme_file"
}

if [[ "${1:-}" == "--all" ]]; then
  while IFS= read -r theme; do
    printf '%s|' "$theme"
    theme_colors "$(theme-dir "$theme")/colors.toml"
  done < <(theme-list)
  exit 0
fi

theme="${1:-}"
if [[ -z "$theme" ]]; then
  echo "Usage: theme-colors <theme>|--all" >&2
  exit 1
fi

if ! theme-list | grep -Fxq "$theme"; then
  echo "Theme does not exist: $theme" >&2
  exit 1
fi

theme_colors "$(theme-dir "$theme")/colors.toml"
