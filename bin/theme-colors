#!/usr/bin/env bash

set -euo pipefail

ATLAS_PATH="${ATLAS_PATH:-$HOME/.local/share/atlas}"
THEMES_DIR="$ATLAS_PATH/themes"

theme_colors() {
  local theme_file="$1"

  awk '
    /^(background|foreground|color[1-5])[[:space:]]*=/ {
      split($0, assignment, "=")
      key = assignment[1]
      gsub(/[[:space:]]/, "", key)
      split($0, fields, "\"")
      colors[key] = fields[2]
    }
    END {
      if (!colors["background"] || !colors["foreground"])
        exit 1
      for (i = 1; i <= 5; i++)
        if (!colors["color" i])
          exit 1

      printf "%s|%s", colors["background"], colors["foreground"]
      for (i = 1; i <= 5; i++)
        printf "|%s", colors["color" i]
      printf "\n"
    }
  ' "$theme_file"
}

if [[ "${1:-}" == "--all" ]]; then
  while IFS= read -r theme; do
    printf '%s|' "$theme"
    theme_colors "$THEMES_DIR/$theme/colors.toml"
  done < <(theme-list)
  exit 0
fi

theme="${1:-}"
if [[ -z "$theme" ]]; then
  echo "Usage: theme-colors <theme>|--all" >&2
  exit 1
fi

if ! theme-list | grep -Fxq "$theme"; then
  echo "Theme does not exist: $theme" >&2
  exit 1
fi

theme_colors "$THEMES_DIR/$theme/colors.toml"
