#!/usr/bin/env bash

set -euo pipefail

ATLAS_PATH="${ATLAS_PATH:-$HOME/.local/share/atlas}"
mode="${1:-general}"

case "$mode" in
  general)
    search_dir="$HOME/Pictures/wallpapers"
    ;;
  theme)
    theme_file="${HOME}/.config/style/current/theme"
    [[ -f "$theme_file" ]] || exit 0
    theme="$(<"$theme_file")"
    search_dir="$ATLAS_PATH/themes/$theme/wallpapers"
    ;;
  *)
    echo "Usage: wallpaper-list [general|theme]" >&2
    exit 2
    ;;
esac

[[ -d "$search_dir" ]] || exit 0

find "$search_dir" -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
  -print | sort
